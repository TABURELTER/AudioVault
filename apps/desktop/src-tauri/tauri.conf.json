{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioVault",
  "version": "0.1.0",
  "identifier": "com.taburelter.audiovault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioVault",
        "theme": "Dark",
        "backgroundColor": "#191a1c",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TABURELTER",
    "category": "Utility",
    "shortDescription": "Desktop-менеджер локальной библиотеки аудиокниг и электронных книг",
    "longDescription": "AudioVault — кроссплатформенное настольное приложение на Rust и Tauri 2 для каталогизации, поиска дубликатов и управления коллекцией аудиокниг и электронных книг.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
