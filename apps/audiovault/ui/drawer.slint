import { Theme, BookItem, CopyItem, MediaItem } from "theme.slint";
import { AppButton, Badge, StatusDot } from "widgets.slint";

export component BookDrawer inherits Rectangle {
    in property <bool> is_open: false;
    in property <BookItem> book;
    in property <[CopyItem]> copies: [];
    in property <[MediaItem]> media_files: [];
    in-out property <int> selected_copy_id: 0;

    callback close();
    callback open_folder(int); // copy_id
    callback edit_book(int); // book_id
    callback delete_copy(int); // copy_id
    callback optimize_copy(int); // copy_id

    if (root.is_open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        TouchArea {
            clicked => { root.close(); }
        }

        // Inspector drawer sliding in from the right
        Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: min(560px, parent.width);
            height: parent.height;
            background: Theme.surface;
            border-width: 0px;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }

            // Click within drawer doesn't close it
            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Header with Close button
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Карточка книги";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: touch_close.has-hover ? Theme.surface_hover : transparent;

                        touch_close := TouchArea {
                            clicked => { root.close(); }
                        }

                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Theme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Book Hero Info
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    // Cover Placeholder / Icon
                    Rectangle {
                        width: 90px;
                        height: 120px;
                        border-radius: Theme.radius_md;
                        background: Theme.surface_variant;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "🎧";
                            font-size: 36px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.book.title;
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.book.authors;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.primary;
                        }
                        if (root.book.narrator != "") : Text {
                            text: "Читает: \{root.book.narrator}";
                            font-size: 13px;
                            color: Theme.text_secondary;
                        }
                        if (root.book.series != "") : Text {
                            text: "Цикл: \{root.book.series} #\{root.book.series_index}";
                            font-size: 12px;
                            color: Theme.purple;
                            font-weight: 500;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 6px;
                            Badge {
                                text: root.book.format_badge;
                                bg_color: Theme.primary_light;
                                fg_color: Theme.primary;
                            }
                            Badge {
                                text: "⏱ \{root.book.duration_str}";
                                bg_color: Theme.surface_variant;
                                fg_color: Theme.text_secondary;
                            }
                            Badge {
                                text: "⭐ \{root.book.quality_score}/100";
                                bg_color: root.book.quality_score >= 80 ? Theme.success_bg : Theme.warning_bg;
                                fg_color: root.book.quality_score >= 80 ? Theme.success : Theme.warning;
                            }
                        }
                    }
                }

                // Actions row
                HorizontalLayout {
                    spacing: 8px;
                    AppButton {
                        text: "Редактировать";
                        icon_text: "✏️";
                        secondary: true;
                        clicked => { root.edit_book(root.book.id); }
                    }
                    if (root.selected_copy_id > 0) : AppButton {
                        text: "Открыть папку";
                        icon_text: "📂";
                        secondary: true;
                        clicked => { root.open_folder(root.selected_copy_id); }
                    }
                    if (root.selected_copy_id > 0) : AppButton {
                        text: "Оптимизировать";
                        icon_text: "⚡";
                        secondary: true;
                        clicked => { root.optimize_copy(root.selected_copy_id); }
                    }
                    if (root.selected_copy_id > 0) : AppButton {
                        text: "Удалить";
                        icon_text: "🗑️";
                        danger: true;
                        clicked => { root.delete_copy(root.selected_copy_id); }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Copies section
                Text {
                    text: "ФИЗИЧЕСКИЕ КОПИИ (\{root.copies.length})";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text_muted;
                }

                VerticalLayout {
                    spacing: 8px;
                    for copy in root.copies : Rectangle {
                        height: 72px;
                        border-radius: Theme.radius_md;
                        background: (root.selected_copy_id == copy.id) ? Theme.primary_light : Theme.surface_variant;
                        border-width: 1px;
                        border-color: (root.selected_copy_id == copy.id) ? Theme.primary : Theme.border;

                        TouchArea {
                            clicked => { root.selected_copy_id = copy.id; }
                        }

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 6px;
                                    StatusDot {
                                        active: copy.volume_online;
                                        dot_color: copy.volume_online ? Theme.success : Theme.danger;
                                    }
                                    Text {
                                        text: copy.volume_name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text_primary;
                                    }
                                    Badge {
                                        text: copy.codec;
                                        font_size: 9px;
                                    }
                                    Badge {
                                        text: copy.bitrate_str;
                                        font_size: 9px;
                                    }
                                }
                                Text {
                                    text: copy.rel_path;
                                    font-size: 10px;
                                    color: Theme.text_muted;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                Text {
                                    text: copy.size_str;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: end;
                                }
                                Text {
                                    text: "\{copy.files_count} ф., \{copy.duration_str}";
                                    font-size: 10px;
                                    color: Theme.text_secondary;
                                    horizontal-alignment: end;
                                }
                            }
                        }
                    }
                }

                // Audio files list
                Text {
                    text: "АУДИОФАЙЛЫ КОПИИ (\{root.media_files.length})";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text_muted;
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius_md;
                    background: Theme.surface_variant;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        for file in root.media_files : Rectangle {
                            height: 28px;
                            border-radius: Theme.radius_sm;
                            background: transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                Text {
                                    text: file.track_no > 0 ? ("\{file.track_no}. \{file.file_name}") : ("• \{file.file_name}");
                                    font-size: 11px;
                                    color: Theme.text_primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: "\{file.duration_str} | \{file.size_str}";
                                    font-size: 10px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
