import { Theme } from "theme.slint";
import { AppButton, AppInput } from "widgets.slint";

export component ConfirmDeleteModal inherits Rectangle {
    in property <bool> is_open: false;
    in property <string> item_title: "";
    in property <string> item_path: "";
    in-out property <bool> permanent_delete: false;

    callback cancel();
    callback confirm(bool); // bool: permanent

    if (root.is_open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000088;

        // Block clicks underneath
        TouchArea {}

        Rectangle {
            width: 480px;
            height: 290px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius_xl;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "🗑️";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Удаление копии книги";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: root.item_title;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.primary;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius_md;
                    background: Theme.surface_variant;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: "Путь: \{root.item_path}";
                            font-size: 11px;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Checkbox: Permanent delete
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius_md;
                    background: root.permanent_delete ? Theme.danger_bg : transparent;

                    TouchArea {
                        clicked => { root.permanent_delete = !root.permanent_delete; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        padding-left: 8px;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 4px;
                            border-width: 1.5px;
                            border-color: root.permanent_delete ? Theme.danger : Theme.border;
                            background: root.permanent_delete ? Theme.danger : transparent;
                            Text {
                                text: root.permanent_delete ? "✓" : "";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Удалить безвозвратно мимо корзины (опасно)";
                            font-size: 12px;
                            color: root.permanent_delete ? Theme.danger : Theme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    AppButton {
                        text: "Отмена";
                        secondary: true;
                        clicked => { root.cancel(); }
                    }
                    AppButton {
                        text: root.permanent_delete ? "Удалить навсегда" : "Переместить в корзину";
                        danger: true;
                        clicked => { root.confirm(root.permanent_delete); }
                    }
                }
            }
        }
    }
}

export component EditBookModal inherits Rectangle {
    in property <bool> is_open: false;
    in property <int> book_id: 0;
    in-out property <string> title: "";
    in-out property <string> authors: "";
    in-out property <string> narrator: "";
    in-out property <string> series: "";
    in-out property <string> series_index: "";

    callback cancel();
    callback save(string, string, string, string, string);

    if (root.is_open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000088;

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius_xl;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                Text {
                    text: "Редактирование метаданных";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text_primary;
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Название"; font-size: 12px; color: Theme.text_secondary; font-weight: 600; }
                    AppInput { text <=> root.title; placeholder: "Название аудиокниги"; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Автор(ы) через запятую"; font-size: 12px; color: Theme.text_secondary; font-weight: 600; }
                    AppInput { text <=> root.authors; placeholder: "Автор"; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Чтец / Исполнитель"; font-size: 12px; color: Theme.text_secondary; font-weight: 600; }
                    AppInput { text <=> root.narrator; placeholder: "Чтец"; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 4px;
                        Text { text: "Серия / Цикл"; font-size: 12px; color: Theme.text_secondary; font-weight: 600; }
                        AppInput { text <=> root.series; placeholder: "Название серии"; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Номер"; font-size: 12px; color: Theme.text_secondary; font-weight: 600; }
                        AppInput { text <=> root.series_index; placeholder: "№"; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    AppButton {
                        text: "Отмена";
                        secondary: true;
                        clicked => { root.cancel(); }
                    }
                    AppButton {
                        text: "Сохранить изменения";
                        primary: true;
                        clicked => {
                            root.save(root.title, root.authors, root.narrator, root.series, root.series_index);
                        }
                    }
                }
            }
        }
    }
}
