import { Theme, TorrentSearchResultItem } from "../theme.slint";
import { AppInput, AppButton, Badge, Card, EmptyState } from "../widgets.slint";

export component TorrentSearchPage inherits VerticalLayout {
    in property <[TorrentSearchResultItem]> results: [];
    in-out property <string> query: "";
    in property <bool> is_searching: false;
    in property <bool> has_credentials: true;

    callback search(string);
    callback download(string); // topic_id
    callback open_settings();

    spacing: 16px;
    padding: 24px;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Поиск на RuTracker";
            font-size: 18px;
            font-weight: 700;
            color: Theme.text_primary;
        }
        Text {
            text: "Прямой встроенный поиск аудиокниг с парсингом структуры раздач и авто-импортом в библиотеку.";
            font-size: 12px;
            color: Theme.text_secondary;
        }
    }

    if (!root.has_credentials) : Rectangle {
        height: 48px;
        border-radius: Theme.radius_md;
        background: Theme.warning_bg;
        border-width: 1px;
        border-color: Theme.warning;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text { text: "⚠️"; font-size: 14px; vertical-alignment: center; }
                Text {
                    text: "Для загрузки раздач укажите логин и пароль RuTracker в Настройках (пароль хранится в системном OS Keyring).";
                    font-size: 12px;
                    color: Theme.warning;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            AppButton {
                text: "Открыть настройки";
                secondary: true;
                clicked => { root.open_settings(); }
            }
        }
    }

    // Search bar
    HorizontalLayout {
        spacing: 12px;
        AppInput {
            horizontal-stretch: 1;
            placeholder: "Поиск аудиокниг на RuTracker (автор, название, чтец)...";
            leading_icon: "🌐";
            text <=> root.query;
            accepted(q) => { root.search(q); }
        }
        AppButton {
            text: root.is_searching ? "Поиск..." : "Найти раздачи";
            primary: true;
            disabled: root.is_searching;
            clicked => { root.search(root.query); }
        }
    }

    if (root.results.length == 0 && root.query != "" && !root.is_searching) : EmptyState {
        icon: "🔍";
        title: "Раздач не найдено";
        message: "Попробуйте изменить поисковый запрос.";
    }

    // Results list
    VerticalLayout {
        spacing: 8px;

        for item in root.results : Card {
            height: 72px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: item.title;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        if (item.author != "") : Text {
                            text: item.author;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.primary;
                        }
                        if (item.reader != "") : Text {
                            text: "• читает: \{item.reader}";
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                        if (item.bitrate != "") : Badge {
                            text: item.bitrate;
                            font-size: 9px;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: item.size_str;
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text_primary;
                            horizontal-alignment: end;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "▲ \{item.seeds}";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.success;
                            }
                            Text {
                                text: "▼ \{item.leeches}";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }
                    }

                    AppButton {
                        text: "Скачать";
                        icon_text: "⬇️";
                        primary: true;
                        clicked => { root.download(item.topic_id); }
                    }
                }
            }
        }
    }
}
