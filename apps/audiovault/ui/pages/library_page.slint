import { Theme, BookItem } from "../theme.slint";
import { AppInput, AppButton, Badge, Card, StatusDot, EmptyState } from "../widgets.slint";

export component LibraryPage inherits VerticalLayout {
    in property <[BookItem]> books: [];
    in-out property <string> filter_query: "";
    in-out property <int> sort_by: 0; // 0: Author, 1: Title, 2: Duration, 3: Quality

    callback select_book(int); // book_id
    callback filter_changed(string);
    callback sort_changed(int);
    callback scan_all();

    spacing: 16px;
    padding: 20px;

    // Filter and controls bar
    HorizontalLayout {
        spacing: 12px;
        alignment: space-between;

        AppInput {
            width: 320px;
            placeholder: "Фильтр в библиотеке...";
            leading_icon: "🔍";
            text <=> root.filter_query;
            edited(txt) => { root.filter_changed(txt); }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: "Сортировка:";
                font-size: 12px;
                color: Theme.text_muted;
                vertical-alignment: center;
            }

            AppButton {
                text: "Автор";
                primary: root.sort_by == 0;
                secondary: root.sort_by != 0;
                clicked => { root.sort_by = 0; root.sort_changed(0); }
            }

            AppButton {
                text: "Название";
                primary: root.sort_by == 1;
                secondary: root.sort_by != 1;
                clicked => { root.sort_by = 1; root.sort_changed(1); }
            }

            AppButton {
                text: "Качество";
                primary: root.sort_by == 3;
                secondary: root.sort_by != 3;
                clicked => { root.sort_by = 3; root.sort_changed(3); }
            }

            AppButton {
                text: "Сканировать";
                icon_text: "📡";
                secondary: true;
                clicked => { root.scan_all(); }
            }
        }
    }

    if (root.books.length == 0) : EmptyState {
        icon: "📚";
        title: "Книг пока нет";
        message: "Добавьте корневую папку в разделе 'Хранилища' или дождитесь окончания сканирования.";
    }

    // Books list/grid
    VerticalLayout {
        spacing: 8px;

        for book in root.books : Card {
            hoverable: true;
            height: 68px;
            clicked => { root.select_book(book.id); }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 14px;
                alignment: space-between;

                // Cover / Icon
                Rectangle {
                    width: 38px;
                    height: 50px;
                    border-radius: Theme.radius_sm;
                    background: Theme.surface_variant;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: "📖";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Title, Author, Narrator
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: book.title;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                        if (book.series != "") : Badge {
                            text: "\{book.series} #\{book.series_index}";
                            bg_color: Theme.purple_bg;
                            fg_color: Theme.purple;
                            font_size: 9px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: book.authors;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.primary;
                            overflow: elide;
                        }
                        if (book.narrator != "") : Text {
                            text: "• читает: \{book.narrator}";
                            font-size: 12px;
                            color: Theme.text_secondary;
                            overflow: elide;
                        }
                    }
                }

                // Volume indicator, duration, codec, quality
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        StatusDot {
                            active: book.volume_online;
                            dot_color: book.volume_online ? Theme.success : Theme.danger;
                        }
                        Text {
                            text: book.volume_name;
                            font-size: 11px;
                            color: book.volume_online ? Theme.text_secondary : Theme.text_muted;
                        }
                    }

                    Badge {
                        text: book.format_badge;
                    }

                    Badge {
                        text: book.duration_str;
                    }

                    Badge {
                        text: "⭐ \{book.quality_score}";
                        bg_color: book.quality_score >= 80 ? Theme.success_bg : Theme.warning_bg;
                        fg_color: book.quality_score >= 80 ? Theme.success : Theme.warning;
                    }
                }
            }
        }
    }
}
