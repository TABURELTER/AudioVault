import { Theme } from "../theme.slint";
import { AppInput, AppButton, Badge, Card } from "../widgets.slint";

export component SettingsPage inherits VerticalLayout {
    in-out property <string> rutracker_user: "";
    in-out property <string> rutracker_pass: "";
    in-out property <string> ffmpeg_path: "";
    in property <string> ffmpeg_version: "Не найден";
    in property <bool> ffmpeg_ok: false;
    in property <string> app_version: "v0.1.0";
    in property <string> db_path: "";
    in property <string> logs_path: "";
    in-out property <bool> auto_scan: true;

    callback save_credentials(string, string);
    callback test_rutracker_login();
    callback browse_ffmpeg();
    callback detect_ffmpeg();
    callback open_data_dir();
    callback open_logs_dir();
    callback toggle_theme();

    spacing: 20px;
    padding: 24px;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Настройки AudioVault";
            font-size: 18px;
            font-weight: 700;
            color: Theme.text_primary;
        }
        Text {
            text: "Параметры безопасности, мультимедиа-утилит и фонового сканирования.";
            font-size: 12px;
            color: Theme.text_secondary;
        }
    }

    // Settings Cards list
    VerticalLayout {
        spacing: 16px;

        // Card 1: Appearance
        Card {
            height: 80px;
            HorizontalLayout {
                padding: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "Тема оформления"; font-size: 14px; font-weight: 700; color: Theme.text_primary; }
                    Text { text: "Переключение между тёмной и светлой палитрой интерфеса"; font-size: 11px; color: Theme.text_secondary; }
                }
                AppButton {
                    text: Theme.dark_mode ? "Тёмная тема (активна)" : "Светлая тема (активна)";
                    icon_text: Theme.dark_mode ? "🌙" : "☀️";
                    secondary: true;
                    clicked => { root.toggle_theme(); }
                }
            }
        }

        // Card 2: RuTracker Account
        Card {
            height: 180px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Учётная запись RuTracker"; font-size: 14px; font-weight: 700; color: Theme.text_primary; }
                        Text { text: "Пароль надёжно шифруется и сохраняется в системном хранилище ключей (Windows Credential Manager / macOS Keychain / Linux Secret Service)."; font-size: 11px; color: Theme.text_secondary; }
                    }
                    Badge {
                        text: "OS Keyring 4.2";
                        bg_color: Theme.primary_light;
                        fg_color: Theme.primary;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    AppInput {
                        horizontal-stretch: 1;
                        placeholder: "Логин RuTracker";
                        leading_icon: "👤";
                        text <=> root.rutracker_user;
                    }
                    AppInput {
                        horizontal-stretch: 1;
                        placeholder: "Пароль (скрыт)";
                        leading_icon: "🔑";
                        text <=> root.rutracker_pass;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    AppButton {
                        text: "Проверить вход";
                        secondary: true;
                        clicked => { root.test_rutracker_login(); }
                    }
                    AppButton {
                        text: "Сохранить учётные данные";
                        primary: true;
                        clicked => { root.save_credentials(root.rutracker_user, root.rutracker_pass); }
                    }
                }
            }
        }

        // Card 3: FFmpeg
        Card {
            height: 130px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Конвертер FFmpeg"; font-size: 14px; font-weight: 700; color: Theme.text_primary; }
                        Text { text: "Необходим для перепаковки и конвертации в M4B/AAC/Opus с сохранением глав."; font-size: 11px; color: Theme.text_secondary; }
                    }
                    Badge {
                        text: root.ffmpeg_version;
                        bg_color: root.ffmpeg_ok ? Theme.success_bg : Theme.danger_bg;
                        fg_color: root.ffmpeg_ok ? Theme.success : Theme.danger;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    AppInput {
                        horizontal-stretch: 1;
                        placeholder: "Путь к ffmpeg.exe";
                        leading_icon: "🎬";
                        text <=> root.ffmpeg_path;
                    }
                    AppButton {
                        text: "Обзор...";
                        secondary: true;
                        clicked => { root.browse_ffmpeg(); }
                    }
                    AppButton {
                        text: "Автопоиск";
                        primary: true;
                        clicked => { root.detect_ffmpeg(); }
                    }
                }
            }
        }

        // Card 4: About & System Paths
        Card {
            height: 110px;
            HorizontalLayout {
                padding: 16px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "AudioVault"; font-size: 15px; font-weight: 700; color: Theme.text_primary; }
                        Badge { text: root.app_version; }
                    }
                    Text { text: "База данных: \{root.db_path}"; font-size: 11px; color: Theme.text_muted; overflow: elide; }
                    Text { text: "Логи: \{root.logs_path}"; font-size: 11px; color: Theme.text_muted; overflow: elide; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AppButton {
                        text: "Открыть логи";
                        secondary: true;
                        clicked => { root.open_logs_dir(); }
                    }
                    AppButton {
                        text: "Папка данных";
                        secondary: true;
                        clicked => { root.open_data_dir(); }
                    }
                }
            }
        }
    }
}
