import { Theme, DuplicateItem } from "../theme.slint";
import { AppButton, Badge, Card, StatusDot, EmptyState } from "../widgets.slint";

export component DuplicatesPage inherits VerticalLayout {
    in property <[DuplicateItem]> duplicates: [];

    callback keep_a(int); // dup_id
    callback keep_b(int);
    callback keep_both(int);
    callback mark_different(int);
    callback ignore_dup(int);

    spacing: 16px;
    padding: 24px;

    HorizontalLayout {
        alignment: space-between;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Потенциальные дубликаты";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: "Сравнение хэшей, акустических отпечатков Chromaprint и метаданных для безопасной очистки места.";
                font-size: 12px;
                color: Theme.text_secondary;
            }
        }
    }

    if (root.duplicates.length == 0) : EmptyState {
        icon: "✨";
        title: "Дубликатов не обнаружено";
        message: "Все копии аудиокниг в коллекции уникальны.";
    }

    VerticalLayout {
        spacing: 14px;

        for dup in root.duplicates : Card {
            height: 180px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: space-between;

                // Header with title and verdict
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: dup.title;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: dup.authors;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.primary;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Badge {
                            text: dup.verdict;
                            bg_color: Theme.warning_bg;
                            fg_color: Theme.warning;
                        }
                        Badge {
                            text: "Совпадение: \{dup.score}%";
                            bg_color: Theme.primary_light;
                            fg_color: Theme.primary;
                        }
                    }
                }

                // Comparison grid: Copy A vs Copy B
                HorizontalLayout {
                    spacing: 12px;

                    // Copy A
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Theme.radius_md;
                        background: Theme.surface_variant;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                StatusDot { active: dup.a_online; }
                                Text { text: "Вариант A: [\{dup.a_volume}]"; font-size: 11px; font-weight: 700; color: Theme.text_primary; }
                                Badge { text: dup.a_format; font_size: 9px; }
                            }
                            Text { text: "Чтец: \{dup.a_narrator}"; font-size: 11px; color: Theme.text_secondary; }
                            Text { text: "Размер: \{dup.a_size_str} | Время: \{dup.a_duration_str}"; font-size: 10px; color: Theme.text_muted; }
                        }
                    }

                    // Copy B
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Theme.radius_md;
                        background: Theme.surface_variant;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                StatusDot { active: dup.b_online; }
                                Text { text: "Вариант B: [\{dup.b_volume}]"; font-size: 11px; font-weight: 700; color: Theme.text_primary; }
                                Badge { text: dup.b_format; font_size: 9px; }
                            }
                            Text { text: "Чтец: \{dup.b_narrator}"; font-size: 11px; color: Theme.text_secondary; }
                            Text { text: "Размер: \{dup.b_size_str} | Время: \{dup.b_duration_str}"; font-size: 10px; color: Theme.text_muted; }
                        }
                    }
                }

                // Decision Action Buttons
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Улика: \{dup.evidence}";
                        font-size: 11px;
                        color: Theme.text_muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        AppButton {
                            text: "Оставить A";
                            secondary: true;
                            clicked => { root.keep_a(dup.id); }
                        }
                        AppButton {
                            text: "Оставить B";
                            secondary: true;
                            clicked => { root.keep_b(dup.id); }
                        }
                        AppButton {
                            text: "Разные чтецы";
                            ghost: true;
                            clicked => { root.mark_different(dup.id); }
                        }
                        AppButton {
                            text: "Игнорировать";
                            ghost: true;
                            clicked => { root.ignore_dup(dup.id); }
                        }
                    }
                }
            }
        }
    }
}
