import { Theme, BookItem } from "../theme.slint";
import { AppInput, AppButton, Badge, Card, StatusDot, EmptyState } from "../widgets.slint";

export component SearchPage inherits VerticalLayout {
    in property <[BookItem]> search_results: [];
    in-out property <string> search_query: "";
    in property <bool> is_searching: false;

    callback search(string);
    callback select_book(int);

    spacing: 16px;
    padding: 24px;

    // Search Box Hero
    VerticalLayout {
        spacing: 8px;
        alignment: center;

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            AppInput {
                horizontal-stretch: 1;
                placeholder: "Полнотекстовый поиск по авторам, названиям, чтецам, сериям...";
                leading_icon: "🔍";
                text <=> root.search_query;
                accepted(txt) => { root.search(txt); }
                edited(txt) => { root.search(txt); }
            }

            AppButton {
                text: "Искать";
                primary: true;
                clicked => { root.search(root.search_query); }
            }
        }

        Text {
            text: "💡 Поддерживается транслитерация и фонетика: 'dostoevsky' найдёт 'Достоевский', 'lukyanenko' найдёт 'Лукьяненко'";
            font-size: 11px;
            color: Theme.text_muted;
        }
    }

    if (root.search_results.length == 0 && root.search_query != "") : EmptyState {
        icon: "🔎";
        title: "Ничего не найдено";
        message: "Попробуйте изменить формулировку запроса или проверьте наличие книг в библиотеке.";
    }

    if (root.search_results.length > 0) : Text {
        text: "Найдено результатов: \{root.search_results.length}";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text_secondary;
    }

    // Results list
    VerticalLayout {
        spacing: 8px;

        for book in root.search_results : Card {
            hoverable: true;
            height: 64px;
            clicked => { root.select_book(book.id); }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 14px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: book.title;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: book.authors;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.primary;
                        }
                        if (book.narrator != "") : Text {
                            text: "• \{book.narrator}";
                            font-size: 12px;
                            color: Theme.text_secondary;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        StatusDot {
                            active: book.volume_online;
                            dot_color: book.volume_online ? Theme.success : Theme.danger;
                        }
                        Text {
                            text: book.volume_name;
                            font-size: 11px;
                            color: book.volume_online ? Theme.text_secondary : Theme.text_muted;
                        }
                    }

                    Badge {
                        text: book.format_badge;
                    }

                    Badge {
                        text: book.duration_str;
                    }
                }
            }
        }
    }
}
