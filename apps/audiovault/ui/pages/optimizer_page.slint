import { Theme, OptimizerItem } from "../theme.slint";
import { AppButton, Badge, Card, EmptyState } from "../widgets.slint";

export component OptimizerPage inherits VerticalLayout {
    in property <[OptimizerItem]> items: [];

    callback transcode(int); // copy_id
    callback dismiss_recommendation(int);

    spacing: 16px;
    padding: 24px;

    HorizontalLayout {
        alignment: space-between;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Оптимизация и конвертация";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: "Сборка сотен мелких файлов в аккуратный M4B с главами, перекодирование lossless и экономия до 70% места.";
                font-size: 12px;
                color: Theme.text_secondary;
            }
        }
    }

    if (root.items.length == 0) : EmptyState {
        icon: "⚡";
        title: "Все аудиокниги оптимально упакованы";
        message: "Нет раздутых файлов или кандидатов на перепаковку.";
    }

    VerticalLayout {
        spacing: 12px;

        for item in root.items : Card {
            height: 120px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: item.book_title;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: item.authors;
                            font-size: 12px;
                            color: Theme.primary;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Badge {
                            text: "Экономия: \{item.savings_str} (-\{item.savings_pct}%)";
                            bg_color: Theme.success_bg;
                            fg_color: Theme.success;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Текущий формат: \{item.current_codec} \{item.current_bitrate_str} (\{item.current_size_str}) → Цель: \{item.target_format} \{item.target_bitrate_str} (~\{item.estimated_size_str})";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text_secondary;
                        }
                        Text {
                            text: item.notes;
                            font-size: 11px;
                            color: Theme.text_muted;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        AppButton {
                            text: "Конвертировать";
                            icon_text: "⚡";
                            primary: true;
                            clicked => { root.transcode(item.copy_id); }
                        }

                        AppButton {
                            text: "Пропустить";
                            ghost: true;
                            clicked => { root.dismiss_recommendation(item.copy_id); }
                        }
                    }
                }
            }
        }
    }
}
