import { Theme, TaskItem } from "../theme.slint";
import { AppButton, Badge, Card, ProgressBar, StatusDot, EmptyState } from "../widgets.slint";

export component TasksPage inherits VerticalLayout {
    in property <[TaskItem]> tasks: [];
    in property <string> hdd_budget: "1 активный / 0 в очереди";
    in property <string> ssd_budget: "3 активных / 0 в очереди";

    callback cancel_task(int); // task_id

    spacing: 16px;
    padding: 24px;

    HorizontalLayout {
        alignment: space-between;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Фоновые задачи и очереди";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: "Диспетчер разделяет тяжелые операции по дисковым бюджетам (HDD не захлебывается параллельным вводом-выводом).";
                font-size: 12px;
                color: Theme.text_secondary;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Badge {
                text: "HDD: \{root.hdd_budget}";
                bg_color: Theme.surface_variant;
                fg_color: Theme.text_secondary;
            }
            Badge {
                text: "SSD: \{root.ssd_budget}";
                bg_color: Theme.primary_light;
                fg_color: Theme.primary;
            }
        }
    }

    if (root.tasks.length == 0) : EmptyState {
        icon: "⚙️";
        title: "Все задачи завершены";
        message: "Фоновые сканеры и хэшеры простаивают.";
    }

    VerticalLayout {
        spacing: 10px;

        for task in root.tasks : Card {
            height: 84px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        StatusDot { active: true; dot_color: Theme.primary; }
                        Text {
                            text: task.label;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: task.description;
                            font-size: 11px;
                            color: Theme.text_secondary;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Badge {
                            text: "\{Math.round(task.progress_pct * 100)}%";
                        }
                        AppButton {
                            text: "Отмена";
                            ghost: true;
                            clicked => { root.cancel_task(task.id); }
                        }
                    }
                }

                ProgressBar {
                    progress: task.progress_pct;
                }
            }
        }
    }
}
