import { Theme, DownloadItem } from "../theme.slint";
import { AppButton, Badge, Card, ProgressBar, EmptyState } from "../widgets.slint";

export component DownloadsPage inherits VerticalLayout {
    in property <[DownloadItem]> downloads: [];
    in property <string> total_down_speed: "0 KB/s";
    in property <string> total_up_speed: "0 KB/s";

    callback pause_torrent(int);
    callback resume_torrent(int);
    callback delete_torrent(int);

    spacing: 16px;
    padding: 24px;

    HorizontalLayout {
        alignment: space-between;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Загрузки торрентов";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text_primary;
            }
            Text {
                text: "Встроенный движок BitTorrent. По завершении аудиокнига автоматически индексируется в фонотеку.";
                font-size: 12px;
                color: Theme.text_secondary;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;
            Badge {
                text: "⬇️ \{root.total_down_speed}";
                bg_color: Theme.primary_light;
                fg_color: Theme.primary;
                font_size: 12px;
            }
            Badge {
                text: "⬆️ \{root.total_up_speed}";
                bg_color: Theme.surface_variant;
                fg_color: Theme.text_secondary;
                font_size: 12px;
            }
        }
    }

    if (root.downloads.length == 0) : EmptyState {
        icon: "⬇️";
        title: "Нет активных загрузок";
        message: "Найдите аудиокниги на вкладке 'RuTracker' или добавьте magnet-ссылку.";
    }

    VerticalLayout {
        spacing: 12px;

        for dl in root.downloads : Card {
            height: 108px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: dl.name;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            overflow: elide;
                        }
                        Text {
                            text: "\{dl.downloaded_str} из \{dl.size_str} • \{dl.down_speed_str} • ETA: \{dl.eta_str}";
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Badge {
                            text: dl.state;
                            bg_color: dl.state == "downloading" ? Theme.primary_light : Theme.surface_variant;
                            fg_color: dl.state == "downloading" ? Theme.primary : Theme.text_secondary;
                        }

                        if (dl.state == "downloading") : AppButton {
                            text: "Пауза";
                            icon_text: "⏸";
                            secondary: true;
                            clicked => { root.pause_torrent(dl.id); }
                        }

                        if (dl.state == "paused") : AppButton {
                            text: "Продолжить";
                            icon_text: "▶️";
                            primary: true;
                            clicked => { root.resume_torrent(dl.id); }
                        }

                        AppButton {
                            text: "Удалить";
                            icon_text: "🗑️";
                            danger: true;
                            clicked => { root.delete_torrent(dl.id); }
                        }
                    }
                }

                ProgressBar {
                    progress: dl.progress_pct;
                    fill_color: dl.state == "completed" ? Theme.success : Theme.primary;
                }
            }
        }
    }
}
